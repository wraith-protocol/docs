{
  "name": "@wraith-protocol/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "check:placeholders": "tsx scripts/check-placeholders.ts",
    "check:snippets": "tsx scripts/check-snippets.ts && tsx scripts/check-api-examples.ts",
    "check:api-examples": "tsx scripts/check-api-examples.ts",
    "check:integration-guides": "tsx scripts/check-integration-guides.ts",
    "check:solana-contracts": "tsx scripts/check-solana-contracts.ts",
    "check:snippets-extended": "tsx scripts/check-snippets-extended.ts && npm run check:python-quickstart",
    "check:python-quickstart": "tsx scripts/python-quickstart/generate-vectors.ts --check && python3 scripts/python-quickstart/run_quickstart.py --bootstrap",
    "generate:python-quickstart-vectors": "tsx scripts/python-quickstart/generate-vectors.ts",
    "check:nav-coverage": "node scripts/check-nav-coverage.mjs",
    "check:contract-registry": "node --test scripts/check-contract-registry.test.mjs && node scripts/check-contract-registry.mjs",
    "check:compatibility-matrix": "node scripts/check-compatibility-matrix.mjs",
    "check:redirects-and-anchors": "node scripts/check-redirects-and-anchors.mjs",
    "test:redirects-and-anchors": "node --test scripts/check-redirects-and-anchors.test.mjs",
    "test:contract-registry": "node --test scripts/check-contract-registry.test.mjs",
    "test:preview-redirect": "node --test scripts/check-preview-redirect.test.mjs",
    "check:stellar-testnet": "tsx scripts/check-stellar-testnet-snippets.ts",
    "test:stellar-testnet": "node --test scripts/check-stellar-testnet-snippets.test.mjs",
    "generate:stellar-reference": "tsx scripts/generate-stellar-reference.ts",
    "check:stellar-reference": "tsx scripts/generate-stellar-reference.ts --check",
    "generate:playground-fixtures": "node scripts/playground/generate-fixtures.mjs",
    "check:playground-fixtures": "node scripts/playground/generate-fixtures.mjs --check",
    "test:playground": "playwright test --config scripts/playground/tests/playwright.config.ts",
    "mint:validate": "mint validate",
    "mint:broken-links": "mint broken-links",
    "test": "npm run check:snippets && npm run check:integration-guides && npm run check:nav-coverage && npm run check:contract-registry && npm run check:compatibility-matrix && npm run test:redirects-and-anchors"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "@stellar/stellar-sdk": "^13.3.0",
    "@wraith-protocol/sdk": "1.4.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.10.2",
    "js-yaml": "4.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "axios@<1.20.0": ">=1.20.0",
      "follow-redirects@<1.16.1": ">=1.16.1",
      "toml@<4.2.0": "^4.2.0",
      "uuid@<11.1.1": "^11.1.1"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-528h-pc64-c93x",
        "GHSA-hqr4-qq8f-hg3x",
        "GHSA-mjw6-4jj6-33hc"
      ]
    }
  }
}
