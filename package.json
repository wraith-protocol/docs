{
  "name": "@wraith-protocol/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "check:placeholders": "tsx scripts/check-placeholders.ts",
    "check:snippet-allowlist": "tsx scripts/check-snippet-allowlist.ts",
    "test:snippet-allowlist": "tsx --test scripts/snippet-allowlist.test.mjs",
    "check:snippets": "tsx scripts/check-snippets.ts && tsx scripts/check-api-examples.ts && npm run check:sponsored-batch",
    "check:sponsored-batch": "node --import tsx --test scripts/check-sponsored-batch.test.mjs",
    "check:api-examples": "tsx scripts/check-api-examples.ts",
    "check:integration-guides": "tsx scripts/check-integration-guides.ts",
    "check:snippets-extended": "tsx --test scripts/check-snippets-extended.test.mjs && tsx scripts/check-snippets-extended.ts && npm run check:python-quickstart",
    "check:python-quickstart": "tsx scripts/python-quickstart/generate-vectors.ts --check && python3 scripts/python-quickstart/run_quickstart.py --bootstrap",
    "generate:python-quickstart-vectors": "tsx scripts/python-quickstart/generate-vectors.ts",
    "check:nav-coverage": "node scripts/check-nav-coverage.mjs",
    "check:operator-runbook": "node scripts/check-operator-runbook.mjs",
    "test:operator-runbook": "node --test scripts/check-operator-runbook.test.mjs",
    "check:nav-smoke": "node scripts/check-nav-smoke.mjs",
    "test:nav-smoke": "playwright test --config scripts/playground/tests/nav-smoke.config.ts",
    "check:contract-registry": "node --test scripts/check-contract-registry.test.mjs && node scripts/check-contract-registry.mjs",
    "check:compatibility-matrix": "node scripts/check-compatibility-matrix.mjs",
    "check:redirects-and-anchors": "node scripts/check-redirects-and-anchors.mjs",
    "check:broken-links": "node scripts/check-broken-links.mjs --internal-only",
    "check:broken-links:internal": "node scripts/check-broken-links.mjs --internal-only",
    "check:broken-links:external": "node scripts/check-broken-links.mjs --external-only",
    "test:broken-links": "node --test scripts/check-broken-links.test.mjs",
    "test:redirects-and-anchors": "node --test scripts/check-redirects-and-anchors.test.mjs",
    "test:compatibility-matrix": "node --test scripts/check-compatibility-matrix.test.mjs",
    "test:contract-registry": "node --test scripts/check-contract-registry.test.mjs",
    "test:preview-redirect": "node --test scripts/check-preview-redirect.test.mjs",
    "check:stellar-testnet": "tsx scripts/check-stellar-testnet-snippets.ts",
    "test:stellar-testnet": "node --test scripts/check-stellar-testnet-snippets.test.mjs",
    "generate:stellar-reference": "tsx scripts/generate-stellar-reference.ts",
    "check:stellar-reference": "tsx scripts/generate-stellar-reference.ts --check",
    "generate:playground-fixtures": "node scripts/playground/generate-fixtures.mjs",
    "check:playground-fixtures": "node scripts/playground/generate-fixtures.mjs --check",
    "test:playground": "playwright test --config scripts/playground/tests/playwright.config.ts",
    "build:preview": "node scripts/preview/build.mjs",
    "test:preview": "playwright test --config scripts/preview/tests/playwright.config.ts",
    "mint:validate": "mint validate",
    "mint:broken-links": "npx --yes mintlify@4.2.1082 broken-links --check-anchors --check-redirects",
    "test": "npm run check:snippets && npm run check:integration-guides && npm run check:nav-coverage && npm run check:contract-registry && npm run check:compatibility-matrix && npm run check:broken-links:internal && npm run test:broken-links && npm run test:redirects-and-anchors && npm run test:compatibility-matrix"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "@stellar/stellar-sdk": "^13.3.0",
    "@wraith-protocol/sdk": "1.4.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.49.1",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.10.2",
    "js-yaml": "4.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
